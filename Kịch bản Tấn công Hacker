"""
attacks/attacks.py
Mô phỏng các cuộc tấn công vào hệ thống RSA:
1. Tấn công giả mạo chữ ký RSA không sử dụng đệm (No-padding Signature Forgery)
2. Tấn công phân tích số nguyên n nhỏ (Small Modulus Factorization)
3. Tấn công Căn bậc ba Bleichenbacher với e = 3 (Bleichenbacher e=3 Low-Exponent Attack)
"""

import math

def attack_no_padding_forgery(public_key, s1, s2):
    """
    Tấn công giả mạo chữ ký không đệm (Homomorphic property of RSA).
    Do tính chất (m1^d) * (m2^d) = (m1 * m2)^d mod n.
    Nếu hệ thống không dùng padding, từ 2 chữ ký s1, s2, kẻ tấn công tạo ra chữ ký s3 cho m1*m2.
    """
    e, n = public_key
    s3 = (s1 * s2) % n
    return s3

def attack_small_n(n):
    """
    Tấn công phân tích thừa số nguyên tố cho Modulus n nhỏ (Trial Division).
    Dùng để tìm lại p và q khi n có kích thước nhỏ (không an toàn).
    """
    if n % 2 == 0:
        return 2, n // 2
    
    limit = int(math.isqrt(n)) + 1
    for i in range(3, limit, 2):
        if n % i == 0:
            return i, n // i
    return None

def attack_bleichenbacher_e3(public_key, target_hash_hex):
    """
    Mô phỏng tấn công Bleichenbacher e=3 với đệm PKCS#1 v1.5 lỏng lẻo.
    Khi e = 3 và hệ thống quên kiểm tra các byte đệm phía sau, 
    kẻ tấn công có thể lấy căn bậc 3 của số nguyên cấu trúc đệm để tạo chữ ký hợp lệ.
    """
    e, n = public_key
    if e != 3:
        raise ValueError("Tấn công Bleichenbacher này yêu cầu số mũ công khai e = 3!")
    
    hash_bytes = bytes.fromhex(target_hash_hex)
    prefix = b"\x00\x01\xFF\xFF\x00" + hash_bytes
    
    key_bytes = (n.bit_length() + 7) // 8
    padding_len = key_bytes - len(prefix)
    
    payload_bytes = prefix + b"\x00" * padding_len
    target_int = int.frombytes(payload_bytes, byteorder='big')
    
    # Tính căn bậc 3 nguyên làm chữ ký s sao cho s^3approx target_int
    s = int(target_int ** (1/3))
    if (s + 1)**3 <= target_int:
        s += 1
    return s

