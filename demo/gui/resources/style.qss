/* =====================================================
   PINK x YELLOW - PASTEL GLASS THEME
   RSA DIGITAL SIGNATURE - GROUP 11
   ===================================================== */

/* ---------- BẢNG MÀU ---------- */
/*
   Yellow (tab):       #FFF8A7
   White (khung, ô):   #FFFFFF
   Pink (nút, chọn):   #FFD6EB
   Pink hover:         #EE8FC0
   Pink pressed:       #E276B0
   Rose (viền, tiêu đề nhóm): #C2185B
   Plum (chữ trên nền hồng, status bar): #5A1A3C
   Text mặc định:      #3B2A35

   Ghi chú:
   - Giao diện kính mờ: các khung bán trong suốt để ảnh nền
     (vẽ ở BackgroundWidget) lộ qua.
   - Kênh alpha trong rgba() theo thang 0-255,
     ví dụ 100 = 0.40, 235 = 0.92.
   - Khung bao (tab, nhóm) trong suốt nhiều; vùng hiện chữ
     (log, bảng, ô nhập) gần đặc để dễ đọc.
*/

QWidget {
    color: #3B2A35;
}

/* ---------- LABEL & CONTROL ---------- */

QLabel,
QCheckBox,
QRadioButton {
    background: transparent;
}

/* Khi QCheckBox/QRadioButton có QSS, Qt không tự vẽ ô chọn nữa
   nên phải khai báo */

QCheckBox::indicator,
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    background: rgba(255, 255, 255, 230);
    border: 1px solid #C2185B;
}

QCheckBox::indicator {
    border-radius: 3px;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:checked {
    background: #FFD6EB;
}

QRadioButton::indicator:checked {
    background: qradialgradient(
        cx: 0.5, cy: 0.5, radius: 0.5,
        fx: 0.5, fy: 0.5,
        stop: 0 #C2185B,
        stop: 0.5 #C2185B,
        stop: 0.6 #FFFFFF,
        stop: 1 #FFFFFF
    );
}

/* ---------- TIÊU ĐỀ ỨNG DỤNG ---------- */

QLabel#Title {
    background: rgba(255, 255, 255, 210);
    color: #5A1A3C;
    font-size: 19px;
    font-weight: 700;
    border: 1px solid #FFD6EB;
    border-radius: 16px;
    padding: 6px 24px;
}

/* ---------- TAB ---------- */

QTabWidget::pane {
    background: rgba(255, 255, 255, 110);
    border: 1px solid rgba(244, 168, 208, 200);
    border-radius: 12px;
}

QTabWidget > QStackedWidget > QWidget {
    background: transparent;
}

QTabBar::tab {
    background: rgba(255, 248, 167, 225);
    color: #5A1A3C;
    font-weight: 600;
    padding: 7px 14px;
    margin-right: 3px;
    border: 1px solid rgba(194, 24, 91, 60);
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

QTabBar::tab:hover:!selected {
    background: #FFF8A7;
}

QTabBar::tab:selected {
    background: #FFD6EB;
    color: #5A1A3C;
    font-weight: 700;
}

/* ---------- GROUP BOX ---------- */

QGroupBox {
    background: rgba(255, 255, 255, 100);
    border: 1px solid rgba(194, 24, 91, 90);
    border-radius: 10px;
    margin-top: 22px;
    padding: 8px;
}

/* Tiêu đề nằm hẳn trên viền vì nền tiêu đề trong suốt */

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 2px;
    background: transparent;
    color: #C2185B;
    font-weight: 700;
}

/* ---------- Ô NHẬP ---------- */

QLineEdit,
QSpinBox,
QComboBox {
    background: rgba(255, 255, 255, 225);
    border: 1px solid rgba(194, 24, 91, 90);
    border-radius: 6px;
    padding: 3px 6px;
}

QLineEdit:focus,
QSpinBox:focus,
QComboBox:focus {
    background: #FFFFFF;
    border: 1px solid #C2185B;
}

QLineEdit:read-only {
    background: rgba(250, 236, 243, 225);
}

/* Danh sách xổ xuống: nền đặc cho dễ đọc */

QComboBox QAbstractItemView {
    background: #FFFFFF;
    selection-background-color: #FFD6EB;
    selection-color: #5A1A3C;
}

/* ---------- BẢNG & VÙNG HIỂN THỊ ---------- */

QTableView,
QTextEdit,
QPlainTextEdit,
QListView,
QTreeView {
    background: rgba(255, 255, 255, 235);
    border: 1px solid rgba(194, 24, 91, 70);
    border-radius: 10px;
    alternate-background-color: rgba(252, 232, 242, 235);
    selection-background-color: #FFD6EB;
    selection-color: #5A1A3C;
}

QTextEdit:focus,
QPlainTextEdit:focus {
    border: 1px solid #C2185B;
}

QPlainTextEdit:disabled {
    background: rgba(240, 228, 234, 200);
    color: #9A8590;
}

/* Viewport của vùng cuộn có nền trắng riêng:
   phải để trong suốt thì khung mới bán trong suốt thật */

QAbstractScrollArea > QWidget#qt_scrollarea_viewport {
    background: transparent;
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QHeaderView {
    background: transparent;
}

/* Tiêu đề cột cùng màu vàng với tab */

QHeaderView::section {
    background: rgba(255, 248, 167, 235);
    color: #5A1A3C;
    border: none;
    border-bottom: 1px solid rgba(194, 24, 91, 90);
    padding: 4px;
    font-weight: 700;
}

QTableCornerButton::section {
    background: transparent;
    border: none;
}

QSplitter::handle {
    background: transparent;
}

/* ---------- THANH CUỘN ---------- */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: rgba(194, 24, 91, 90);
    border-radius: 3px;
    min-height: 30px;
    min-width: 30px;
}

QScrollBar::handle:hover {
    background: rgba(194, 24, 91, 160);
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
}

/* ---------- NÚT ---------- */

QPushButton {
    background: #FFD6EB;
    color: #5A1A3C;
    font-weight: 600;
    border: 1px solid rgba(194, 24, 91, 70);
    border-radius: 6px;
    padding: 6px 12px;
}

QPushButton:hover {
    background: #EE8FC0;
}

QPushButton:pressed {
    background: #E276B0;
}

QPushButton:disabled {
    background: rgba(244, 168, 208, 100);
    color: rgba(90, 26, 60, 120);
    border-color: transparent;
}

/* ---------- STATUS BAR ---------- */

QStatusBar {
    background: #5A1A3C;
    color: #FFFFFF;
}

QStatusBar QLabel {
    color: #FFFFFF;
    padding: 2px 6px;
}

/* ---------- PROGRESS BAR ---------- */

QProgressBar {
    background: #7A3A5C;
    border: none;
    border-radius: 4px;
    max-height: 8px;
}

QProgressBar::chunk {
    background: #FFD6EB;
    border-radius: 4px;
}
