/* =====================================================
   PINK x YELLOW - PASTEL GLASS THEME
   RSA DIGITAL SIGNATURE - GROUP 11
   ===================================================== */

/* ---------- BẢNG MÀU ---------- */
/*
   Yellow (tab):       #FFF7C8
   White (khung, ô):   #FFFFFF
   Pink (nút, chọn):   #FFD6EB
   Pink hover:         #EE8FC0
   Pink pressed:       #E276B0
   Rose (viền, tiêu đề nhóm): #C2185B
   Plum (chữ trên nền hồng, status bar): #5A1A3C
   Text mặc định:      #3B2A35

   Ghi chú:
   - Giao diện kính mờ: các khung bán trong suốt để ảnh nền
     (vẽ ở BackgroundWidget) lộ qua.
   - Kênh alpha trong rgba() theo thang 0-255,
     ví dụ 100 = 0.40, 235 = 0.92.
   - Khung bao (tab, nhóm) trong suốt nhiều; vùng hiện chữ
     (log, bảng, ô nhập) gần đặc để dễ đọc.
*/

QWidget {
    color: #3B2A35;
}

/* ---------- LABEL & CONTROL ---------- */

QLabel,
QCheckBox,
QRadioButton {
    background: transparent;
}

/* Khi QCheckBox/QRadioButton có QSS, Qt không tự vẽ ô chọn nữa
   nên phải khai báo */

QCheckBox::indicator,
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    background: rgba(255, 255, 255, 230);
    border: 1px solid #C2185B;
}

QCheckBox::indicator {
    border-radius: 3px;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:checked {
    background: #FFD6EB;
}

QRadioButton::indicator:checked {
    background: qradialgradient(
        cx: 0.5, cy: 0.5, radius: 0.5,
        fx: 0.5, fy: 0.5,
        stop: 0 #C2185B,
        stop: 0.5 #C2185B,
        stop: 0.6 #FFFFFF,
        stop: 1 #FFFFFF
    );
}

/* ---------- TIÊU ĐỀ ỨNG DỤNG ---------- */

QLabel#Title {
    background: rgba(255, 255, 255, 245);
    color: #5A1A3C;
    font-size: 19px;
    font-weight: 700;
    border: 2px solid #FFD6EB;
    border-radius: 20px;       /* < nửa chiều cao (42 px) nếu không Qt bỏ bo góc */
    padding: 6px 32px;
}

/* ---------- TAB ---------- */

QTabWidget::pane {
    background: rgba(255, 255, 255, 110);
    border: 1px solid rgba(244, 168, 208, 200);
    border-radius: 12px;
}

QTabWidget > QStackedWidget > QWidget {
    background: transparent;
}

QTabBar::tab {
    background: rgba(255, 248, 167, 225);
    color: #5A1A3C;
    font-weight: 600;
    padding: 7px 14px;
    margin-right: 3px;
    border: 1px solid rgba(194, 24, 91, 60);
    border-bottom: none;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}

QTabBar::tab:hover:!selected {
    background: #FFF7C8;
}

QTabBar::tab:selected {
    background: #FFD6EB;
    color: #5A1A3C;
    font-weight: 700;
}

/* ---------- GROUP BOX ---------- */

QGroupBox {
    background: rgba(255, 255, 255, 100);
    border: 1px solid rgba(194, 24, 91, 90);
    border-radius: 12px;
    margin-top: 26px;
    padding: 8px;
}

/* Tiêu đề nằm trong một "nhãn" nền trắng, viền hồng, đè lên viền khung để dễ đọc trên ảnh nền */

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 3px 12px;
    background: #D6E8FF;
    border: 1px solid #7FB1F0;
    border-radius: 12px;      /* = nửa chiều cao nhãn → hình viên thuốc */
    color: #123F86;
    font-weight: 700;
}

/* ---------- Ô NHẬP ---------- */

QLineEdit,
QSpinBox,
QComboBox {
    background: rgba(255, 255, 255, 225);
    border: 1px solid rgba(194, 24, 91, 90);
    border-radius: 8px;
    padding: 3px 6px;
}

QLineEdit:focus,
QSpinBox:focus,
QComboBox:focus {
    background: #FFFFFF;
    border: 1px solid #C2185B;
}

/* Nút tăng/giảm của QSpinBox: khi QSpinBox có QSS, Qt không tự vẽ mũi tên nữa nên phải khai báo */

QSpinBox {
    padding-right: 20px;
}

QSpinBox::up-button,
QSpinBox::down-button {
    subcontrol-origin: padding;
    width: 16px;
    background: #FFF8A7;
    border-left: 1px solid rgba(194, 24, 91, 90);
}

QSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 7px;
}

QSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 7px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
    background: #F4A8D0;
}

QSpinBox::up-arrow {
    image: url(RES/arrow_up.svg);
    width: 8px;
    height: 5px;
}

QSpinBox::down-arrow {
    image: url(RES/arrow_down.svg);
    width: 8px;
    height: 5px;
}

QLineEdit:read-only {
    background: rgba(250, 236, 243, 225);
}

/* Danh sách xổ xuống: nền đặc cho dễ đọc */

QComboBox QAbstractItemView {
    background: #FFFFFF;
    selection-background-color: #FFD6EB;
    selection-color: #5A1A3C;
}

/* ---------- BẢNG & VÙNG HIỂN THỊ ---------- */

QTableView,
QTextEdit,
QPlainTextEdit,
QListView,
QTreeView {
    background: rgba(255, 255, 255, 235);
    border: 1px solid rgba(194, 24, 91, 70);
    border-radius: 12px;
    alternate-background-color: rgba(252, 232, 242, 235);
    selection-background-color: #FFD6EB;
    selection-color: #5A1A3C;
}

QListView {
    padding: 4px;
}

QTreeView::item:selected {
    background: #FFD6EB;
    color: #5A1A3C;
    border-radius: 6px;
}

/* Mỗi lựa chọn trong danh sách là một ô riêng: viền hồng, bo 8 px như nút */

QListWidget::item {
    background: rgba(255, 255, 255, 235);
    border: 1px solid rgba(194, 24, 91, 70);
    border-radius: 8px;
    padding: 2px 10px;
    margin: 1px 2px;
}

QListWidget::item:hover {
    background: #FFF8A7;
}

QListWidget::item:selected {
    background: #FFD6EB;
    border: 1px solid #C2185B;
    color: #5A1A3C;
}

/* Dòng đầu nhóm (KỊCH BẢN / TẤN CÔNG) không phải lựa chọn: không viền, không nền */

QListWidget::item:disabled {
    background: transparent;
    border: none;
    color: #123F86;
    padding: 4px 4px 0px 4px;
}

QTextEdit:focus,
QPlainTextEdit:focus {
    border: 1px solid #C2185B;
}

QPlainTextEdit:disabled {
    background: rgba(240, 228, 234, 200);
    color: #9A8590;
}

/* Viewport của vùng cuộn có nền trắng riêng:
   phải để trong suốt thì khung mới bán trong suốt thật */

QAbstractScrollArea > QWidget#qt_scrollarea_viewport {
    background: transparent;
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

/* Ô "Từng bước tính toán" (StepView): nền trắng như ô văn bản ở tab Ký / Kiểm tra */

QScrollArea#StepView {
    background: rgba(255, 255, 255, 235);
    border: 1px solid rgba(194, 24, 91, 70);
    border-radius: 12px;
}

QHeaderView {
    background: transparent;
}

/* Tiêu đề cột cùng màu vàng với tab */

QHeaderView::section {
    background: rgba(255, 248, 167, 235);
    color: #5A1A3C;
    border: none;
    border-bottom: 1px solid rgba(194, 24, 91, 90);
    padding: 4px;
    font-weight: 700;
}

QHeaderView::section:first {
    border-top-left-radius: 11px;
}

QHeaderView::section:last {
    border-top-right-radius: 11px;
}

QTableCornerButton::section {
    background: transparent;
    border: none;
}

QSplitter::handle {
    background: transparent;
}

/* ---------- THANH CUỘN ---------- */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: rgba(194, 24, 91, 90);
    border-radius: 3px;
    min-height: 30px;
    min-width: 30px;
}

QScrollBar::handle:hover {
    background: rgba(194, 24, 91, 160);
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
}

/* ---------- NÚT ---------- */

QPushButton {
    background: #FFD6EB;
    color: #5A1A3C;
    font-weight: 600;
    border: 1px solid rgba(194, 24, 91, 70);
    border-radius: 8px;
    padding: 6px 12px;
}

QPushButton:hover {
    background: #EE8FC0;
}

QPushButton:pressed {
    background: #E276B0;
}

QPushButton:disabled {
    background: rgba(244, 168, 208, 100);
    color: rgba(90, 26, 60, 120);
    border-color: transparent;
}

/* ---------- STATUS BAR ---------- */

QStatusBar {
    background: #5A1A3C;
    color: #FFFFFF;
}

QStatusBar QLabel {
    color: #FFFFFF;
    padding: 2px 6px;
}

/* ---------- PROGRESS BAR ---------- */

QProgressBar {
    background: #7A3A5C;
    border: none;
    border-radius: 4px;
    max-height: 8px;
}

QProgressBar::chunk {
    background: #FFD6EB;
    border-radius: 4px;
}
