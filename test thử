import keygen
import rsa_core

def test_full_flow():
    print("--- BẮT ĐẦU TEST HỆ THỐNG RSA ---")
    
    # 1. Sinh khóa (gọi từ file keygen.py của Thu Thuỷ)
    print("1. Đang sinh cặp khóa RSA (1024-bit)...")
    private_key, public_key = keygen.generate_keypair(keysize=1024)
    print("   -> OK! Đã sinh khóa thành công.")
    
    # 2. Tạo thông điệp
    message = "Đây là tài liệu quan trọng cần chữ ký số."
    print(f"2. Thông điệp gốc: '{message}'")
    
    # 3. Ký số (gọi hàm từ rsa_core.py của bạn, bên trong hàm này sẽ tự gọi sha256.py của Mai Phương)
    print("3. Đang thực hiện băm và ký số...")
    try:
        signature = rsa_core.sign_message(message, private_key)
        print("   -> OK! Chữ ký tạo thành công.")
    except Exception as e:
        print("   -> LỖI KHI KÝ:", e)
        return

    # 4. Xác thực (gọi hàm kiểm tra từ rsa_core.py)
    print("4. Đang kiểm tra xác thực chữ ký...")
    try:
        is_valid = rsa_core.verify_message(message, signature, public_key)
        if is_valid:
            print("   -> KẾT QUẢ: THÀNH CÔNG! Chữ ký hợp lệ. Các module đã khớp nối hoàn hảo.")
        else:
            print("   -> KẾT QUẢ: THẤT BẠI! Chữ ký bị từ chối.")
    except Exception as e:
        print("   -> LỖI KHI KIỂM TRA:", e)

    # 5. Test thử trường hợp hacker thay đổi dữ liệu
    print("\n5. Test kịch bản dữ liệu bị sửa đổi trên đường truyền...")
    fake_message = "Đây là tài liệu quan trọng cần chữ ký số (đã bị sửa)."
    is_valid_fake = rsa_core.verify_message(fake_message, signature, public_key)
    if not is_valid_fake:
         print("   -> KẾT QUẢ: HỆ THỐNG HOẠT ĐỘNG ĐÚNG! Đã phát hiện ra dữ liệu bị sửa đổi.")
    else:
         print("   -> KẾT QUẢ: LỖI! Hệ thống không phát hiện được sự thay đổi.")

if __name__ == "__main__":
    test_full_flow()
